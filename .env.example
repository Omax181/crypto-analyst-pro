# =============================================================================
# Variables d'environnement — V31
# =============================================================================
# Cette liste ne contient QUE les clés réellement lues par le code. Les entrées
# des sources supprimées (CoinMarketCap, CoinMarketCal, Coinglass, Glassnode,
# LunarCrush, DefiLlama, NewsAPI, YouTube, GitHub, Telethon) ont été retirées :
# une clé documentée mais jamais lue laisse croire à une capacité inexistante.
#
# Les PARAMÈTRES MÉTIER (budget, ticket minimum, frais, bandes de liquidité,
# avantage revendicable, seuils de bruit, matérialité…) ne sont PAS ici : ils
# vivent dans config/params.yaml. Absents, le moteur reste NON_EVALUABLE et le
# dit — il n'invente jamais de valeur.

# === IA (Gemini) ===
GEMINI_API_KEY=            # https://aistudio.google.com/apikey
GEMINI_MODEL=              # modèle primaire (vide = gemini-2.5-flash)
GEMINI_FALLBACK_MODEL=     # repli — DOIT différer du primaire, sinon déclaré inopérant

# === Sources ===
COINGECKO_API_KEY=         # optionnel (free tier) — prix, séries, OHLC
FRED_API_KEY=              # https://fred.stlouisfed.org/docs/api/api_key.html
ETHERSCAN_API_KEY=         # https://etherscan.io/apis (on-chain ETH)

# === Email ===
GMAIL_USER=                # adresse d'envoi
GMAIL_APP_PASSWORD=        # https://myaccount.google.com/apppasswords
RECIPIENT_EMAIL=           # destinataire (peut être identique)

# === Telegram — notifications + bot ===
TELEGRAM_BOT_TOKEN=        # @BotFather
TELEGRAM_CHAT_ID=          # seul chat servi (filtre de sécurité)
RELAY_PULL_URL=            # URL /pull du Worker Cloudflare (vide = polling)
RELAY_SECRET=              # secret partagé avec le Worker
PORTFOLIO_EDIT_PASSWORD=   # requis pour /buy /sell /set ; absent = lecture seule

# === Comportement ===
LOG_LEVEL=INFO
